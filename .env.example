# Copy to .env (or paste into your hosting dashboard). NEVER share these values.
APP_NAME=Smart Shop Manager
BASE_URL=https://yourdomain.com
SECRET_KEY=paste-a-long-random-value
DATABASE_URL=postgresql://user:password@host:5432/smartshop
DATA_DIR=/var/data
TZ_OFFSET_HOURS=0

# You (the platform owner) - created on first start
SUPERADMIN_EMAIL=you@yourdomain.com
SUPERADMIN_PASSWORD=choose-a-strong-password

# Paystack (MoMo + card payments in GHS) - dashboard.paystack.com > Settings > API Keys
PAYSTACK_SECRET_KEY=sk_live_xxxxx

# Phone notifications - make with:  python app.py genkeys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@yourdomain.com

# Daily summary: call https://yourdomain.com/cron/daily?key=THIS_VALUE every evening (e.g. 9 PM)
CRON_KEY=paste-a-random-value
